# Base image is supplied by CI (vars.AGENT_BASE_IMAGE); it must provide a
# Docker-in-Docker capable runner with Python available.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

COPY pyproject.toml .
COPY src/ src/

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir --ignore-requires-python ".[web]"

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m", "nugget"]
